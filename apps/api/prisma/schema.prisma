// Cross-posting app schema.
//
// ConnectedAccount is the entity everything references — not User, not Platform.
// A user can hold several accounts on the same platform, each with its own token.
//
// Platform tokens live here on the backend only. The client never receives them;
// it holds a session token for this API and every publish call originates server-side.
// See CLAUDE.md "Target platforms".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  x
  threads
  instagram
  tiktok
  linkedin
}

enum AccountStatus {
  active
  needs_reauth
  revoked
}

enum PostStatus {
  draft
  queued
  publishing
  completed // every target reached a terminal state; check targets for per-account outcome
}

enum PostTargetStatus {
  queued
  publishing
  published
  failed
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectedAccounts ConnectedAccount[]
  posts             Post[]
}

model ConnectedAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform          Platform
  platformAccountId String // the platform's own id for this account

  // Display fields for the account picker.
  displayName String?
  handle      String?
  avatarUrl   String?

  // Never serialized to the client.
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?

  status AccountStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postTargets PostTarget[]

  // Reconnecting the same account must update the existing row, not duplicate it.
  @@unique([userId, platform, platformAccountId])
  // The token-refresh job walks accounts by expiry; it does not scan per platform.
  @@index([status, expiresAt])
}

model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Shared across all targets in v1. Per-target override exists in the schema
  // but has no editing UI — see CLAUDE.md "Data model".
  caption String

  status      PostStatus @default(draft)
  scheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets PostTarget[]

  @@index([userId, createdAt])
}

model PostTarget {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // A specific account, not a platform.
  connectedAccountId String
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  status PostTargetStatus @default(queued)

  // Reserved for later. Falls back to Post.caption when null. Do not build the
  // editing UI until real users ask for it.
  captionOverride String?

  platformPostId String?
  errorMessage   String?
  attemptCount   Int       @default(0)
  publishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One target per account per post.
  @@unique([postId, connectedAccountId])
  // The publish worker claims work by status; targets are processed independently
  // for failure isolation and per-account rate limiting.
  @@index([status, createdAt])
  @@index([connectedAccountId, status])
}
